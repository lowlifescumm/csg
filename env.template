# Cosmic Spiritual Guide - Environment Variables Template
# Copy this file to .env.local for local development
# Set these variables in your Render dashboard for production

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/cosmic_spiritual_guide

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secure-jwt-secret-here

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Resend Email API (for password reset and transit notifications)
RESEND_API_KEY=re_your-resend-api-key-here

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=csg-tarot
PINECONE_DIM=1536
PINECONE_METRIC=cosine

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# App Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# Google Maps API (for location geocoding in birth chart form)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# NextAuth.js (for OAuth authentication)
# IMPORTANT: For production on Render, set NEXTAUTH_URL to your production URL
# Examples: https://cosmicspiritguide.com or https://csg-sj6e.onrender.com
# Must match exactly (including https://) - no trailing slash
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32
# Note: trustHost is now set to true in code for Render compatibility

# PDF Generation API (optional - for serverless environments like Render)
# If not set, will try to use Puppeteer with Chrome (requires Chrome installation)
# Recommended services: html2pdf.app, pdfshift.io, htmltoPDF API
PDF_API_URL=https://api.html2pdf.app/v1/generate
PDF_API_KEY=your-pdf-api-key-here

# Google OAuth (for Google Sign-In)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Cron Job Security (for scheduled tasks)
CRON_SECRET=your-cron-secret-here

# Cloudinary Image Storage
# Get these from https://cloudinary.com/console
# Option 1: Use the single CLOUDINARY_URL variable (recommended)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Option 2: Use individual credentials (if you prefer)
# CLOUDINARY_CLOUD_NAME=your-cloud-name-here
# CLOUDINARY_API_KEY=your-api-key-here
# CLOUDINARY_API_SECRET=your-api-secret-here

# PDF Report Generation Engine
# Options: 'puppeteer' (default) or 'template' (pdfme)
# If not set, defaults to 'puppeteer'. Can be overridden via ?engine= query parameter.
# To rollback: set REPORT_ENGINE=puppeteer and redeploy. Old pipeline remains intact.
REPORT_ENGINE=puppeteer
